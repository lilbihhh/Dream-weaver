{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.invalid/schemas/audit-log.schema.json","title":"NEXUS Ledger Event","description":"Strict allow-listed event for the synthetic, non-actuating policy simulation. No free-form user content or raw neural/PII fields are permitted.","type":"object","additionalProperties":false,"required":["ts","event_id","regime","safety_decision","intent_summary","envelope_id","inputs_hash","notes","prev_hash","event_hash"],"properties":{"ts":{"type":"string","format":"date-time"},"event_id":{"type":"string","format":"uuid"},"regime":{"enum":["Consolidation","Expansion","Stabilization","Safe-State"]},"safety_decision":{"enum":["ALLOW","VETO"]},"intent_summary":{"const":"synthetic_policy_pass"},"envelope_id":{"type":"null"},"inputs_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"notes":{"type":"string","pattern":"^[A-Z_]{1,64}$"},"prev_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}